# =============================================================
# Nyay Saathi — root .gitignore
# =============================================================

# ----- Python ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ----- Node / Next.js ----------------------------------------
node_modules/
.next/
out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# ----- Environment files (NEVER commit real secrets) ---------
.env
.env.local
.env.*.local
.env.production
.env.staging
# Keep .env.example and .env.local.example — they are safe templates
!.env.example
!.env.local.example

# ----- Generated output files --------------------------------
backend/outputs/

# ----- Old backup (not needed, current frontend is in frontend/) -----
frontend_backup/

# ----- OS / editor -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
